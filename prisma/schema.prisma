generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  emailVerified DateTime?
  image         String?
  role          Role      @default(AGENT)
  companyId     String?
  activeCompanyId String?
  phone     String?
  agency    String?
  bio       String?
  avatar    String?
  passwordHash String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company     Company?    @relation(fields: [companyId], references: [id], onDelete: SetNull)
  properties   Property[]
  interesados  Interesado[]
  tasks        Task[]
  publications Publication[]
  interactions Interaction[]
  accounts     Account[]
  sessions     Session[]
  facebookAccounts FacebookAccount[]
  dealsCreated      Deal[]
  dealParticipants  DealParticipant[]
  commissions       Commission[]

  @@index([companyId])
  @@map("users")
}

model Company {
  id        String   @id @default(cuid())
  name      String
  ruc       String?  @unique
  maxAgents Int?
  maxProperties Int?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users          User[]
  properties     Property[]
  interesados    Interesado[]
  tasks          Task[]
  deals          Deal[]
  publications   Publication[]
  commissions    Commission[]

  @@map("companies")
}

model FacebookAccount {
  id             String     @id @default(cuid())
  userId         String
  pageId         String
  pageName       String
  accessToken    String
  tokenExpiresAt DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, pageId])
  @@map("facebook_accounts")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Property {
  id          String         @id @default(cuid())
  title       String
  description String?
  price       Decimal        @db.Decimal(12, 2)
  currency    Currency       @default(PEN)
  address     String
  city        String
  district    String?
  state       String?
  country     String         @default("Peru")
  latitude    Float?
  longitude   Float?
  bedrooms    Int?
  bathrooms   Int?
  area        Float?
  areaUnit    AreaUnit       @default(M2)
  type        PropertyType   @default(HOUSE)
  status      PropertyStatus @default(ACTIVE)
  features    String[]
  yearBuilt   Int?
  parking     Int?
  floors      Int?
  videoUrl     String?
  contactName  String?
  contactPhone String?
  featuredText1 String?
  featuredText2 String?
userId      String
  companyId   String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  company      Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  photos       PropertyPhoto[]
  interesados  Interesado[]
  tasks        Task[]
  publications Publication[]
  deals        Deal[]

  @@index([userId])
  @@index([companyId])
  @@index([city])
  @@index([status])
  @@index([price])
  @@map("properties")
}

model PropertyPhoto {
  id         String   @id @default(cuid())
  url        String
  alt        String?
  isPrimary  Boolean  @default(false)
  sortOrder  Int      @default(0)
  propertyId String
  createdAt  DateTime @default(now())

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@map("property_photos")
}

model Interesado {
  id         String     @id @default(cuid())
  name       String
  email      String?
  phone      String?
  source     InteresadoSource @default(WEB)
  status     InteresadoStatus @default(NEW)
  notes      String?
  budget     Decimal?   @db.Decimal(12, 2)
  currency   Currency   @default(PEN)
  interestLevel Int?
  nextFollowUpAt DateTime?
userId     String
  propertyId String?
companyId  String
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  property     Property?     @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  tasks        Task[]
  interactions Interaction[]
  deals        Deal[]

  @@index([userId])
  @@index([companyId])
  @@index([status])
  @@index([propertyId])
  @@map("interesados")
}

model Interaction {
  id        String          @id @default(cuid())
  type      InteractionType
  content   String?
  interesadoId String    @map("leadId")
  userId    String
  createdAt DateTime        @default(now())

  interesado Interesado @relation(fields: [interesadoId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([interesadoId])
  @@map("interactions")
}

model Task {
  id          String    @id @default(cuid())
  title       String
  description String?
  dueDate     DateTime?
  completed   Boolean   @default(false)
  priority    Priority  @default(MEDIUM)
  userId      String
interesadoId String?    @map("leadId")
  propertyId  String?
  companyId   String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  interesado Interesado? @relation(fields: [interesadoId], references: [id], onDelete: SetNull)
  property Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([companyId])
  @@index([completed])
  @@index([dueDate])
  @@map("tasks")
}

model Publication {
  id          String    @id @default(cuid())
  platform    Platform
  status      PubStatus @default(PENDING)
  externalId  String?
  externalUrl String?
  publishedAt DateTime?
propertyId  String
  userId      String
  companyId   String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@index([companyId])
  @@index([platform])
  @@map("publications")
}

model Deal {
  id            String        @id @default(cuid())
  title         String
  propertyId    String
  interesadoId  String?       @map("leadId")
  status        DealStatus    @default(OPEN)
  salePrice     Decimal?      @db.Decimal(12, 2)
  commissionPct Float?
  totalCommission Decimal?    @db.Decimal(12, 2)
  notes         String?
createdById   String
  companyId     String
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  property     Property          @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  interesado   Interesado?       @relation(fields: [interesadoId], references: [id], onDelete: SetNull)
  createdBy    User              @relation(fields: [createdById], references: [id], onDelete: Restrict)
  company      Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  participants DealParticipant[]
  commissions  Commission[]

  @@index([propertyId])
  @@index([companyId])
  @@index([createdById])
  @@index([status])
  @@map("deals")
}

model DealParticipant {
  id       String              @id @default(cuid())
  dealId   String
  userId   String
  role     DealParticipantRole @default(PRIMARY)
  sharePct Float?

  deal Deal @relation(fields: [dealId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([dealId, userId])
  @@index([userId])
  @@map("deal_participants")
}

model Commission {
  id        String           @id @default(cuid())
dealId    String?
userId    String
  companyId String
  amount    Decimal          @db.Decimal(12, 2)
  currency  Currency         @default(PEN)
  status    CommissionStatus @default(PENDING)
  paidAt    DateTime?
  notes     String?
  createdAt DateTime         @default(now())

  deal    Deal?    @relation(fields: [dealId], references: [id], onDelete: SetNull)
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([companyId])
  @@index([dealId])
  @@map("commissions")
}

enum Role {
  ADMIN
  OWNER
  AGENT
}

enum Currency {
  PEN
  USD
  EUR
}

enum AreaUnit {
  M2
  SQFT
}

enum PropertyType {
  HOUSE
  APARTMENT
  CONDO
  LAND
  OFFICE
  WAREHOUSE
  OTHER
}

enum PropertyStatus {
  ACTIVE
  SOLD
  RENTED
  INACTIVE
  PENDING
}

enum InteresadoSource {
  WEB
  PHONE
  EMAIL
  REFERRAL
  FACEBOOK
  INSTAGRAM
  WHATSAPP
  OTHER
}

enum InteresadoStatus {
  NEW
  CONTACTED
  QUALIFIED
  NEGOTIATION
  CLOSED_WON
  CLOSED_LOST
}

enum InteractionType {
  CALL
  EMAIL
  SMS
  MEETING
  NOTE
  WHATSAPP
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum Platform {
  FACEBOOK
  INSTAGRAM
  CUSTOM_WEBSITE
}

enum PubStatus {
  PENDING
  PUBLISHED
  FAILED
  REMOVED
}

enum DealStatus {
  OPEN
  NEGOTIATION
  CLOSED_WON
  CLOSED_LOST
  CANCELLED
}

enum DealParticipantRole {
  PRIMARY
  CO_BROKER
  REFERRAL
}

enum CommissionStatus {
  PENDING
  PAID
  CANCELLED
}


