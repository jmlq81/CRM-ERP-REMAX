generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  emailVerified DateTime?
  image         String?
  role          Role      @default(AGENT)
  phone     String?
  agency    String?
  bio       String?
  avatar    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  properties   Property[]
  leads        Lead[]
  tasks        Task[]
  publications Publication[]
  interactions Interaction[]
  accounts     Account[]
  sessions     Session[]
  facebookAccounts FacebookAccount[]

  @@map("users")
}

model FacebookAccount {
  id             String     @id @default(cuid())
  userId         String
  pageId         String
  pageName       String
  accessToken    String
  tokenExpiresAt DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, pageId])
  @@map("facebook_accounts")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Property {
  id          String         @id @default(cuid())
  title       String
  description String?
  price       Decimal        @db.Decimal(12, 2)
  currency    Currency       @default(PEN)
  address     String
  city        String
  district    String?
  state       String?
  country     String         @default("Peru")
  latitude    Float?
  longitude   Float?
  bedrooms    Int?
  bathrooms   Int?
  area        Float?
  areaUnit    AreaUnit       @default(M2)
  type        PropertyType   @default(HOUSE)
  status      PropertyStatus @default(ACTIVE)
  features    String[]
  yearBuilt   Int?
  parking     Int?
  floors      Int?
  userId      String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  photos       PropertyPhoto[]
  leads        Lead[]
  tasks        Task[]
  publications Publication[]

  @@index([userId])
  @@index([city])
  @@index([status])
  @@index([price])
  @@map("properties")
}

model PropertyPhoto {
  id         String   @id @default(cuid())
  url        String
  alt        String?
  isPrimary  Boolean  @default(false)
  sortOrder  Int      @default(0)
  propertyId String
  createdAt  DateTime @default(now())

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@map("property_photos")
}

model Lead {
  id         String     @id @default(cuid())
  name       String
  email      String?
  phone      String?
  source     LeadSource @default(WEB)
  status     LeadStatus @default(NEW)
  notes      String?
  budget     Decimal?   @db.Decimal(12, 2)
  currency   Currency   @default(PEN)
  userId     String
  propertyId String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  property     Property?     @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  tasks        Task[]
  interactions Interaction[]

  @@index([userId])
  @@index([status])
  @@index([propertyId])
  @@map("leads")
}

model Interaction {
  id        String          @id @default(cuid())
  type      InteractionType
  content   String?
  leadId    String
  userId    String
  createdAt DateTime        @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@map("interactions")
}

model Task {
  id          String    @id @default(cuid())
  title       String
  description String?
  dueDate     DateTime?
  completed   Boolean   @default(false)
  priority    Priority  @default(MEDIUM)
  userId      String
  leadId      String?
  propertyId  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lead     Lead?     @relation(fields: [leadId], references: [id], onDelete: SetNull)
  property Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([completed])
  @@index([dueDate])
  @@map("tasks")
}

model Publication {
  id          String    @id @default(cuid())
  platform    Platform
  status      PubStatus @default(PENDING)
  externalId  String?
  externalUrl String?
  publishedAt DateTime?
  propertyId  String
  userId      String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@index([platform])
  @@map("publications")
}

enum Role {
  ADMIN
  AGENT
}

enum Currency {
  PEN
  USD
  EUR
}

enum AreaUnit {
  M2
  SQFT
}

enum PropertyType {
  HOUSE
  APARTMENT
  CONDO
  LAND
  OFFICE
  WAREHOUSE
  OTHER
}

enum PropertyStatus {
  ACTIVE
  SOLD
  RENTED
  INACTIVE
  PENDING
}

enum LeadSource {
  WEB
  PHONE
  EMAIL
  REFERRAL
  FACEBOOK
  INSTAGRAM
  WHATSAPP
  OTHER
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  NEGOTIATION
  CLOSED_WON
  CLOSED_LOST
}

enum InteractionType {
  CALL
  EMAIL
  SMS
  MEETING
  NOTE
  WHATSAPP
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum Platform {
  FACEBOOK
  INSTAGRAM
  CUSTOM_WEBSITE
}

enum PubStatus {
  PENDING
  PUBLISHED
  FAILED
  REMOVED
}
